<!-- These resources are around just to allow their values to be
     customized for different hardware and product builds. -->
<resources>
    <!-- The A8 2016 has a 1080p display (not 1440p like the S6) -->
    <!-- Override the common tree's 560dpi with 480dpi -->
    <!-- This is used for boot animation resolution -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">80</integer>
    <integer name="config_screenBrightnessDark">1</integer>
    <bool name="config_screenBrightnessAlwaysOn">false</bool>

    <!-- The A8 2016 does NOT have an IR blaster -->
    <bool name="config_hasIrEmitter">false</bool>

    <!-- Device has a fingerprint sensor -->
    <bool name="config_hasFingerprintSensor">true</bool>

    <!-- Device supports NFC -->
    <bool name="config_hasNfc">true</bool>
</resources>
