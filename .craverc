#!/bin/bash
# .craverc - Pre-build setup script executed by crave before build commands
# See: https://foss.crave.io/docs/crave-usage/#craverc-run-commands-file
#
# This script runs AFTER crave creates the LOS 20 workspace and BEFORE build commands.
# The LOS 20 pre-synced source already includes most AOSP/LOS repos.
# We only clone what's NOT in the standard LOS 20 manifest.
#
# IMPORTANT: Only git clone is used (NOT repo sync), per crave.io rules.

echo "[.craverc] Starting pre-build setup..."

###############################################################################
# 1. Clone repos NOT in the standard LOS 20 manifest
###############################################################################

# Device tree (our custom repo - NOT in LOS 20)
if [ ! -d "device/samsung/a8xelte" ]; then
    echo "[.craverc] Cloning a8xelte device tree..."
    git clone https://github.com/RedHatOnTop/android_device_samsung_a8xelte \
        --branch lineage-20.0 --depth=1 device/samsung/a8xelte || echo "[.craverc] WARN: Failed to clone device tree"
fi

# Common Exynos 7420 device tree (NOT in LOS 20)
if [ ! -d "device/samsung/universal7420-common" ]; then
    echo "[.craverc] Cloning universal7420-common device tree..."
    git clone https://github.com/samsungexynos7420/android_device_samsung_universal7420-common \
        --branch lineage-20.0-unify --depth=1 device/samsung/universal7420-common || echo "[.craverc] WARN: Failed to clone common tree"
fi

# Kernel (NOT in LOS 20 - custom exynos7420 kernel)
if [ ! -d "kernel/samsung/universal7420" ]; then
    echo "[.craverc] Cloning kernel..."
    git clone https://github.com/samsungexynos7420/android_kernel_samsung_universal7420 \
        --branch lineage-20 --depth=1 kernel/samsung/universal7420 || echo "[.craverc] WARN: Failed to clone kernel"
fi

# Vendor blobs - common Exynos 7420 (NOT in LOS 20)
# Use temp dir + copy to avoid conflicts with existing vendor/samsung/
if [ ! -f "vendor/samsung/universal7420-common/universal7420-common-vendor.mk" ]; then
    echo "[.craverc] Setting up common vendor blobs..."
    rm -rf /tmp/prop_vendor_samsung 2>/dev/null || true
    git clone https://github.com/samsungexynos7420/proprietary_vendor_samsung \
        --branch lineage-20.0-unify --depth=1 /tmp/prop_vendor_samsung || echo "[.craverc] WARN: Failed to clone common vendor"
    if [ -d "/tmp/prop_vendor_samsung" ]; then
        mkdir -p vendor/samsung
        # Copy all subdirectories (universal7420-common, zeroflte, etc.)
        for dir in /tmp/prop_vendor_samsung/*/; do
            dirname=$(basename "$dir")
            if [ "$dirname" != ".git" ]; then
                mkdir -p "vendor/samsung/$dirname"
                cp -r "$dir"* "vendor/samsung/$dirname/" 2>/dev/null || true
                cp -r "$dir".[!.]* "vendor/samsung/$dirname/" 2>/dev/null || true
            fi
        done
        echo "[.craverc] Common vendor blobs copied."
    fi
fi

# Vendor blobs - a8xelte device-specific (NOT in LOS 20)
if [ ! -d "vendor/samsung/a8xelte" ]; then
    echo "[.craverc] Cloning a8xelte vendor blobs..."
    git clone https://github.com/RedHatOnTop/proprietary_vendor_samsung_a8xelte \
        --branch lineage-20.0 --depth=1 vendor/samsung/a8xelte || echo "[.craverc] WARN: Failed to clone a8xelte vendor blobs"
fi

# Linaro BSP HALs (NOT in LOS 20)
for hal in exynos exynos5 openmax graphics config; do
    dir="hardware/samsung_slsi-linaro/$hal"
    if [ ! -d "$dir" ]; then
        repo_name="android_hardware_samsung_slsi-linaro_$hal"
        echo "[.craverc] Cloning Linaro BSP: $hal..."
        git clone "https://github.com/samsungexynos7420/$repo_name" \
            --branch lineage-20 --depth=1 "$dir" || echo "[.craverc] WARN: Failed to clone $hal"
    fi
done

# NOTE: hardware/samsung, device/samsung_slsi/sepolicy are already in LOS 20 manifest
# and should be present in the pre-synced source. Do NOT clone them.

###############################################################################
# 2. Apply 7420 patches (framework compatibility for old 3.10 kernel)
###############################################################################

PATCHES_DIR="$HOME/7420_patches"
if [ ! -d "$PATCHES_DIR" ]; then
    echo "[.craverc] Cloning 7420 patches..."
    rm -rf "$PATCHES_DIR" 2>/dev/null || true
    git clone https://github.com/samsungexynos7420/7420_patches \
        --branch lineage-20.0 --depth=1 "$PATCHES_DIR" 2>/dev/null || echo "[.craverc] WARN: Failed to clone patches"
fi

if [ -d "$PATCHES_DIR" ] && [ -f "$PATCHES_DIR/apply.sh" ]; then
    echo "[.craverc] Applying 7420 patches..."
    OLDDIR=$(pwd)
    cd /tmp
    bash "$PATCHES_DIR/apply.sh" 2>&1 || echo "[.craverc] WARN: Some patches failed (may be already applied)"
    cd "$OLDDIR"
fi

echo "[.craverc] Pre-build setup complete."
